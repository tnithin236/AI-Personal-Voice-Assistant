# Copy to .env and edit. Every value is optional; defaults are shown.
# VAANI_OLLAMA_URL=http://localhost:11434
# VAANI_LLM_MODEL=gemma3:4b
# VAANI_NUM_CTX=4096
# VAANI_NUM_GPU=-1            # -1 = let Ollama decide; 0 = CPU only; N = N layers on GPU
# VAANI_MAX_TOKENS=400
# VAANI_WHISPER_MODEL=small
# VAANI_WHISPER_BEAM=1        # Tamil + Auto. Use 5 for Tamil accuracy.
# VAANI_WHISPER_BEAM_EN=1     # when the language is fixed to English
# VAANI_WHISPER_THREADS=0     # 0 = default (4). Try 8 on a 16-thread CPU.
# VAANI_PIPER_VOICE=en_US-lessac-medium
# VAANI_PIPER_EXE=            # optional: full path to piper.exe if "python -m piper" fails
# VAANI_TAMIL_TTS_URL=http://127.0.0.1:8010
# VAANI_ALLOWED_ORIGINS=["http://localhost:5173"]
